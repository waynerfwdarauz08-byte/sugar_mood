<mxfile host="app.diagrams.net"><diagram name="SUGAR MOOD · Día 2" id="sugar-mood"><mxGraphModel grid="1" page="1" pageWidth="2030" pageHeight="2000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="categorias" value="categorias&#10;&#10;id INT PK AI&#10;nombre VARCHAR(80) NN UQ&#10;descripcion VARCHAR(255) NULL" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#e7f3ef;strokeColor=#126a6c;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="330" height="150" as="geometry"/></mxCell><mxCell id="productos" value="productos&#10;&#10;id INT PK AI&#10;categoriaId INT FK NN&#10;nombre VARCHAR(100) NN UQ&#10;precio DECIMAL(10,2) NN &gt;= 0&#10;activo BOOLEAN NN DEFAULT TRUE&#10;stock INT NN &gt;= 0 DEFAULT 0&#10;stockMinimo INT NN &gt;= 0 DEFAULT 5&#10;imagen VARCHAR(100) NULL" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#e7f3ef;strokeColor=#126a6c;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="400" height="300" as="geometry"/></mxCell><mxCell id="detalles_pedido" value="detalles_pedido&#10;&#10;id INT PK AI&#10;pedidoId INT FK NN&#10;productoId INT FK NN&#10;cantidad INT NN &gt; 0&#10;precioUnitario DECIMAL(10,2) NN &gt;= 0&#10;UQ (pedidoId, productoId)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#e7f3ef;strokeColor=#126a6c;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="400" height="230" as="geometry"/></mxCell><mxCell id="roles" value="roles&#10;&#10;id INT PK AI&#10;codigo VARCHAR(40) NN UQ&#10;nombre VARCHAR(80) NN UQ&#10;descripcion VARCHAR(255) NULL&#10;Iniciales: administrador / cliente" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#e7f3ef;strokeColor=#126a6c;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="520" y="40" width="400" height="180" as="g