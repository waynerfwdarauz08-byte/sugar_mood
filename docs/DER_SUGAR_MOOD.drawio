nt as="offset"/></mxGeometry></mxCell><mxCell id="label3b" value="0..1" style="edgeLabel;html=0;align=center;resizable=0;fontSize=14;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e3"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;startArrow=none;strokeColor=#126a6c;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="clientes" target="pedidos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="label4a" value="1" style="edgeLabel;html=0;align=center;resizable=0;fontSize=14;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e4"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="label4b" value="0..N" style="edgeLabel;html=0;align=center;resizable=0;fontSize=14;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e4"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;startArrow=none;strokeColor=#126a6c;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="pedidos" target="detalles_pedido"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="label5a" value="1" style="edgeLabel;html=0;align=center;resizable=0;fontSize=14;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e5"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="label5b" value="1..N" style="edgeLabel;html=0;align=center;resizable=0;fontSize=14;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e5"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="notes" value="PK: primaria · FK: foránea · AI: autoincremental · NN: obligatorio · UQ: único&#10;FK: ON DELETE RESTRICT / ON UPDATE CASCADE. Sequelize: timestamps false.&#10;Usuario pertenece a un rol; puede tener cero o un perfil de cliente. Clientes anteriores pueden no tener cuenta.&#10;Cada pedido tiene al menos un detalle: validado en servicio/transacción. Precio histórico conservado; totales calculados.&#10;Registro público: Cliente. Administrador gestiona cuentas; cada cliente solo accede a su perfil, pedidos y detalles.&#10;fechaCreacion pertenece únicamente a usuarios; no se agregan timestamps a las entidades anteriores." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1280" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>