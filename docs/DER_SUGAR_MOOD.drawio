"1" connectable="0" parent="e12"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;startArrow=none;strokeColor=#126a6c;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="usuarios" target="recuperaciones_password"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="label13a" value="1" style="edgeLabel;html=0;align=center;resizable=0;fontSize=14;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e13"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="label13b" value="0..1" style="edgeLabel;html=0;align=center;resizable=0;fontSize=14;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e13"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="notes" value="Historiales: referencias opcionales SET NULL, con nombre conservado. Pagos conservan referencia RESTRICT al pedido. Rol-permisos y recuperaciones usan CASCADE.&#10;Permisos: Administrador completo; Cliente solo propios; roles nuevos configurables. Tokens de recuperación almacenados como hash, de un uso y 15 minutos.&#10;PK: primaria · FK: foránea · AI: autoincremental · NN: obligatorio · UQ: único&#10;FK: ON DELETE RESTRICT / ON UPDATE CASCADE. Sequelize: timestamps false.&#10;Usuario pertenece a un rol; puede tener cero o un perfil de cliente. Clientes anteriores pueden no tener cuenta.&#10;Cada pedido tiene al menos un detalle: validado en servicio/transacción. Precio histórico conservado; totales calculados.&#10;Registro público: Cliente. Administrador gestiona cuentas y permisos; cada cliente solo accede a sus datos.&#10;fechaCreacion pertenece únicamente a usuarios; no se agregan timestamps a las entidades anteriores." style="text;html=0;align=left;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1780" width="1930" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>